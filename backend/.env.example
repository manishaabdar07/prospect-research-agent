# Copy this file to .env and fill in values as needed. All values below are
# safe local-dev defaults -- the app boots with zero configuration using the
# mock search provider and no Anthropic key (LLM-backed endpoints return a
# clean 503 until ANTHROPIC_API_KEY is set).

# Matches the root docker-compose.yml postgres service exactly
# (user=prospect, password=prospect, db=prospect_research, host port 5433 --
# mapped off the Postgres default 5432 to avoid clashing with any
# already-installed native Postgres service on the host).
DATABASE_URL=postgresql://prospect:prospect@localhost:5433/prospect_research

# Anthropic / LLM. Leave ANTHROPIC_API_KEY unset to run the app without any
# LLM calls -- /research and /synthesize will return 503 until it is set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Search provider: "mock" (default, no key needed, always returns []) or "brave".
SEARCH_PROVIDER=mock
BRAVE_API_KEY=

# Comma-separated list of allowed CORS origins (Vite dev server default shown).
CORS_ORIGINS=http://localhost:5173
