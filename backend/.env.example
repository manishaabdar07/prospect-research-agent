# Copy this file to .env and fill in values as needed. All values below are
# safe local-dev defaults -- the app boots with zero configuration using the
# mock search provider and no OpenAI key (LLM-backed endpoints return a
# clean 503 until OPENAI_API_KEY is set).

# Matches the root docker-compose.yml postgres service exactly
# (user=prospect, password=prospect, db=prospect_research, host port 5433 --
# mapped off the Postgres default 5432 to avoid clashing with any
# already-installed native Postgres service on the host).
DATABASE_URL=postgresql://prospect:prospect@localhost:5433/prospect_research

# OpenAI / LLM. Leave OPENAI_API_KEY unset to run the app without any
# LLM calls -- /research and /generate-email will return 503 until it is set.
# OPENAI_MODEL must support tool/function calling (gpt-4o and later do).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Search provider: "mock" (default, no key needed, always returns []),
# "duckduckgo" (no key needed, scrapes DuckDuckGo's HTML results page), or
# "brave" (needs BRAVE_API_KEY, most reliable of the three).
SEARCH_PROVIDER=mock
BRAVE_API_KEY=

# Comma-separated list of allowed CORS origins (Vite dev server default shown).
CORS_ORIGINS=http://localhost:5173

# Email sending (Stage 6). Generic SMTP only -- leave EMAIL_HOST unset to run
# the app without send capability; /send-email will return 503 until these
# are set. EMAIL_PORT 587 expects STARTTLS, 465 expects implicit TLS (SSL).
EMAIL_PROVIDER=smtp
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
